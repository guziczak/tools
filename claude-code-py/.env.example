# Anthropic API Configuration
#
# Option 1: Claude Max/Pro subscription (use official Claude Code token)
#   Run: npm install -g @anthropic-ai/claude-code
#   Then: claude setup-token
#   Copy token here: CLAUDE_CODE_OAUTH_TOKEN=your-token
#
# Option 2: API key (pay-as-you-go)
#   Leave empty - app will auto-setup on first run!
#   Or set manually: ANTHROPIC_API_KEY=sk-ant-...
#
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# OAuth Configuration
# OAuth doesn't work reliably for third-party clients (Cloudflare blocks it)
# Use Claude Max token instead (see Option 1 above) or API key
#
# Set to 'false' to skip OAuth (default, recommended)
# Set to 'true' to try OAuth (may not work)
CLAUDE_USE_OAUTH=false

# Model Configuration
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=8000
CLAUDE_TEMPERATURE=1.0

# Extended Thinking
CLAUDE_THINKING_ENABLED=true
CLAUDE_THINKING_BUDGET=10000

# Tools Configuration
CLAUDE_TOOLS_ENABLED=true

# Agents Configuration
CLAUDE_AGENTS_ENABLED=true
