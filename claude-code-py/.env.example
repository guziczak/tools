# Anthropic API Configuration
# Option 1 (Recommended): Leave empty to use OAuth (like Claude Code)
# Option 2: Set your API key manually: ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# OAuth Configuration (PKCE flow - same as official Claude Code)
# Set to 'true' to use OAuth (recommended)
# Set to 'false' to use manual API key only
CLAUDE_USE_OAUTH=true

# Model Configuration
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=8000
CLAUDE_TEMPERATURE=1.0

# Extended Thinking
CLAUDE_THINKING_ENABLED=true
CLAUDE_THINKING_BUDGET=10000

# Tools Configuration
CLAUDE_TOOLS_ENABLED=true

# Agents Configuration
CLAUDE_AGENTS_ENABLED=true
