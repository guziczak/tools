# Kimi API Configuration for Claude Code
# When this file is present and configured, Claude Code will use Kimi API instead of Claude Opus

# Kimi API Base URL (Moonshot AI)
KIMI_API_BASE_URL=https://api.moonshot.ai/anthropic

# Kimi API Key (leave empty - add your token here)
KIMI_API_KEY=sk-SkI1RvI2Rr1PXXb1mItTYPi43EBERIqSttQR94q34XanQgsS

# Model to use (k2 is the latest Kimi model)
KIMI_MODEL=kimi-k2-0711-preview

# Optional: API timeout in seconds
API_TIMEOUT=60

# Optional: Max tokens for responses
MAX_TOKENS=4096